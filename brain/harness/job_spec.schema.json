{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brain-forge/job_spec.schema.json",
  "title": "BrainForgeJobSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "intent", "steps"],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "intent": { "type": "string", "minLength": 1 },
    "invariants": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "gates": {
      "type": "array",
      "description": "Shell command strings run for gate steps / end gate",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["canary", "command", "gate"]
          },
          "label": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "argv": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "cwd": { "type": "string" },
          "sql": {
            "type": "string",
            "description": "Optional read-only SELECT for canary steps (passed to canary_sample.py --sql)"
          }
        }
      }
    },
    "autonomous": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_turns": { "type": "integer", "minimum": 1, "default": 3 },
        "max_wall_ms": { "type": "integer", "minimum": 1000, "default": 7200000 },
        "gate_retries": { "type": "integer", "minimum": 0, "default": 1 }
      }
    },
    "canary_required": { "type": "boolean", "default": false },
    "irreversible": { "type": "boolean", "default": false },
    "run_end_gate": { "type": "boolean", "default": true },
    "certificate_path": { "type": "string" }
  }
}
