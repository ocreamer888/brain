# Copy to brain/.env and edit.
# Loaded by brain/mcp/run_server.sh and brain/hooks/run_hook.sh.

BRAIN_BACKEND=api
BRAIN_API_KEY=local-dev-key
# Local API on this machine:
# BRAIN_API_URL=http://127.0.0.1:8787
# Mac Studio on LAN (prefer mDNS; DHCP IPs drift):
BRAIN_API_URL=http://Mac-Studio-de-Abundancia888.local:8787
# BRAIN_API_URL=http://192.168.0.7:8787
