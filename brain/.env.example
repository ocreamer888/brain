# Copy to brain/.env and edit. Never commit the real file (it's gitignored).
# Loaded by brain/mcp/run_server.sh and brain/hooks/run_hook.sh.

BRAIN_BACKEND=api
# Generate your own: openssl rand -hex 32
# Must match BRAIN_API_KEY in the launchd plist that runs brain_api
# (docs/deploy/com.brain.api.plist, or your installed copy at
# ~/Library/LaunchAgents/com.brain.api.plist) -- auth is required by default.
BRAIN_API_KEY=<generate-with-openssl-rand--hex-32>
# Local API on this machine:
# BRAIN_API_URL=http://127.0.0.1:8787
# Mac Studio on LAN (prefer mDNS; DHCP IPs drift):
BRAIN_API_URL=http://Mac-Studio-de-Abundancia888.local:8787
# BRAIN_API_URL=http://<studio-lan-ip>:8787
